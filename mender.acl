///! Vorthur Kernel Build Configuration
///! Format: Anvil Config Language (ACL)
///! Last Updated: June 01 2026

paths {
    output_dir = "./isofiles"
    kernel_binary = "vorthur-kernel.bin"
    iso_output = "vorthur.iso"
}

grub {
    timeout = 5
    default_entry = 0
    entry_name = "vorthur"

    // Boot parameters
    boot_flags = "quiet splash"
    kernel_cmdline = "console=ttyS0,115200n8"
}

build {
    profile = "debug"
    cargo_flags = [
        "-Z json-target-spec",
        "-Z build-std=core,alloc"
    ]
    run_tests = true
    clean_on_failure = true
}

vm {
    hypervisor = "qemu-system-x86_64"
    memory_mb = 1024
    cpu_cores = 2
    enable_kvm = true

    qemu_flags = [
        "-serial mon:stdio",
        "-display none"
    ]
}

environment {
    githooks_path = ".githooks"
    setup_required = true
    min_cargo_version = "1.70"
}
