version(2);
project_name = "mender";

patterns = {
 "*.sh",
 "*.bat",
 "*.4coder",
 "*.rs",
 "*.acl",
};
blacklist_patterns = {
 ".*",
};

load_paths = {
 .win = {
  { .path = ".", .recursive = true, .relative = true, },
  { .path = "./src/", .recursive = true, .relative = true, },
 },
 .linux = {
  { .path = ".", .recursive = true, .relative = true, },
  { .path = "./src/", .recursive = true, .relative = true, },
 },
};

commands = {
 .build_mender = {
  .win = ".cargo build",
  .linux = "cargo build ",
  .out = ".",
  .footer_panel = false,
  .save_dirty_files = false,
  .cursor_at_end = false,
 },
 .run_mender = {
  .win = "cargo build ",
  .linux = "cargo build",
  .out = ".",
  .footer_panel = false,
  .save_dirty_files = false,
  .cursor_at_end = false,
 },
};

fkey_command = {
 .F1 = "build_mender",
 .F2 = "run_mender",
};

