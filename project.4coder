version(2);
project_name = "mender";

clear_blank_lines = true;
indent_with_tabs = true;

patterns = {
  "*.c",
  "*.cpp",
  "*.hpp",
  "*.h",
  "*.m",
  "*.mm",
  "*.bat",
  "*.sh",
  "*.4coder",
  "*.rs",
  "*.toml",

};

blacklist_patterns = { ".*", };

paths = { { .path = ".", .recursive = true, .relative = true, }, };
load_paths = { .win = paths, };

commands = {
  .run      = { .win = ".\\mender.exe build", .out = "*compilation*", .footer_panel = false, .save_dirty_files = true,  .cursor_at_end = true,  },
  .build    = { .win = "build.bat",    .out = "*compilation*", .footer_panel = false, .save_dirty_files = true,  .cursor_at_end = true,  },
  .debugger = { .win = "raddbg .",   .out = "*run*",         .footer_panel = false, .save_dirty_files = false, .cursor_at_end = false, },
};

fkey_command = {
  .F2 = "run",
  .F5 = "build",
  .F9 = "debugger",
};
