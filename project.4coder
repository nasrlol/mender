version(2);
project_name = "mender";

patterns = {
 "*.rs",
 "*.acl",
 "*.toml",
 "*.sh",
 "*.bat",
 "*.4coder",
 };

 blacklist_patterns = {
 ".*",
 "target",
"Cargo.lock",
 };

 paths = {
 { "./",    .relative = true, .recursive = false, },
 { "./src", .relative = true, .recursive = true, },
 };

 load_paths = {
 .win   = paths,
 .linux = paths,
 .mac   = paths,
 };

 commands = {
 .build = {
 .win              = "cargo run",
 .linux            = "cargo run",
 .mac              = "cargo run",
 .out              = "*compilation*",
 .footer_panel     = false,
 .save_dirty_files = true,
 .cursor_at_end    = true,
 },
 .test = {
 .win              = "cargo test",
 .linux            = "cargo test",
 .mac              = "cargo test",
 .out              = "*compilation*",
 .footer_panel     = false,
 .save_dirty_files = true,
 .cursor_at_end    = true,
 },
 .check = {
 .win              = "cargo check",
 .linux            = "cargo check",
 .mac              = "cargo check",
 .out              = "*compilation*",
 .footer_panel     = false,
 .save_dirty_files = true,
 .cursor_at_end    = true,
 },
 };

 fkey_command = {
 .F1 = "build",
 .F2 = "test",
 .F3 = "check",
};
